<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: the counts change only when the app changes
     them, and the app redraws the widget then (CountsWidget.update).
     previewLayout and targetCell* are Android 12's; older launchers ignore
     them and use minWidth/minHeight, which is all this needs. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_counts"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_counts"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
