<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a cloud backup or a device transfer: the web
     view's storage is not safe to copy while it is open, and a half-copied
     one could lose tasks. Tasks move by their own JSON export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
